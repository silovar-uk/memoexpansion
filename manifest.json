{
  "manifest_version": 3,
  "name": "MemoTool",
  "version": "2.1.0",
  "description": "タブ切り替え・装飾・行番号ジャンプ・日時表示・詳細連動移動・1行自動縮小表示に対応したメモツール。内部安定性改善・三点メニュー撤去済み。",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "メモ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}

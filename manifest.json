{
  "manifest_version": 3,
  "name": "MemoTool",
  "version": "2.4.4",
  "description": "タブ切替・新規メモ・メニュー操作のfocusとscrollを自然につなげたInteraction Precision版MemoTool。",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "メモ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-memo-panel": {
      "suggested_key": {
        "default": "Alt+A",
        "windows": "Alt+A",
        "linux": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "メモパネルを開閉し、開いたときは現在のメモにフォーカス"
    }
  },
  "minimum_chrome_version": "142"
}
